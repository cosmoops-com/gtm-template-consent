___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const gtagSet = require('gtagSet');
const localStorage = require('localStorage');
const queryPermission = require('queryPermission');
const JSON = require('JSON');
const logToConsole = require('logToConsole');

// A fixed, unparameterized key — every site running consent's embed script writes its consent
// decision here too (in addition to its own siteId-scoped key, which only the dashboard needs),
// specifically so this template can declare one literal, permission-friendly key name that works
// across every installation, the same way Cookiebot's official template reads one fixed
// "CookieConsent" cookie name rather than a per-customer one. Safe as a flat name because a real
// site only ever runs one siteId's script on its own domain — no cross-tenant collision risk.
const storageKey = 'cosmoops_consent';
const regionDefaults = data.regionDefaults || [];
const waitForUpdate = data.waitForUpdate ? (data.waitForUpdate - 0) : 500;

/**
 * Maps consent's own 4-category model (necessary/preferences/statistics/marketing
 * — see the Banner tab in your consent dashboard) to the 7 Google Consent Mode
 * types, identically to how consent's own embed script does it (generate-banner-
 * script.ts's pushGoogleConsent). Keeping this mapping in one place, matched
 * exactly between the embed script and this template, means a site behaves the
 * same way regardless of which one actually delivers the signal to Google.
 */
function consentTypesFor(categories) {
  return {
    ad_storage: categories.marketing ? 'granted' : 'denied',
    ad_user_data: categories.marketing ? 'granted' : 'denied',
    ad_personalization: categories.marketing ? 'granted' : 'denied',
    analytics_storage: categories.statistics ? 'granted' : 'denied',
    personalization_storage: categories.preferences ? 'granted' : 'denied',
    functionality_storage: categories.preferences ? 'granted' : 'denied',
    security_storage: 'granted',
  };
}

/**
 * Sets the default consent state for every configured region, plus a
 * privacy-conservative Global fallback (deny everything but necessary) if no
 * Global row was configured — matching the embed script's own default posture.
 */
function applyRegionDefaults() {
  let globalDefaults = null;
  const regionEntries = [];

  for (let i = 0; i < regionDefaults.length; i++) {
    const row = regionDefaults[i];
    const consent = consentTypesFor({
      preferences: row.preferences === 'granted',
      statistics: row.statistics === 'granted',
      marketing: row.marketing === 'granted',
    });
    if (waitForUpdate > 0) consent.wait_for_update = waitForUpdate;

    const regions = (row.regions || 'Global')
      .split(',')
      .map((r) => r.trim())
      .filter((r) => r);

    if (regions.length === 0 || regions[0].toLowerCase() === 'global') {
      globalDefaults = consent;
    } else {
      consent.region = regions;
      regionEntries.push(consent);
    }
  }

  if (!globalDefaults) {
    globalDefaults = consentTypesFor({ preferences: false, statistics: false, marketing: false });
    if (waitForUpdate > 0) globalDefaults.wait_for_update = waitForUpdate;
  }

  // Global first, so region-specific rows can override it — same order the
  // Consent Mode spec expects when both are set on the same page load.
  setDefaultConsentState(globalDefaults);
  for (let i = 0; i < regionEntries.length; i++) setDefaultConsentState(regionEntries[i]);
}

/**
 * Restates a visitor's already-stored decision on this page load — mirrors the
 * embed script's own returning-visitor branch, so a page that loads this
 * template (with or without the embed script also present) still reflects a
 * decision made earlier through the actual banner, on a previous page or visit.
 */
function restoreStoredConsent() {
  if (!queryPermission('access_local_storage', 'read', storageKey)) {
    logToConsole('[consent] Missing local storage read permission for', storageKey);
    return;
  }

  const raw = localStorage.getItem(storageKey);
  if (!raw) return;

  // No try/catch — Sandboxed JavaScript doesn't support try/catch/finally at all (confirmed live
  // in Tag Manager's own Template Editor, which rejects the block at parse time). Calling
  // JSON.parse directly is the established pattern for this environment; safe here since this key
  // is only ever written by consent's own embed script via JSON.stringify, never hand-edited.
  const stored = JSON.parse(raw);
  if (!stored || typeof stored !== 'object') return;

  updateConsentState(consentTypesFor({
    preferences: !!stored.preferences,
    statistics: !!stored.statistics,
    marketing: !!stored.marketing,
  }));
}

gtagSet({
  url_passthrough: !!data.urlPassthrough,
  ads_data_redaction: !!data.adsDataRedaction,
});

applyRegionDefaults();
restoreStoredConsent();

data.gtmOnSuccess();


